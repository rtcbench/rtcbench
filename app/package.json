{
  "name": "@rtcbench/app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tailwindcss -i web/styles.css -o ../internal/api/web/styles.css --minify && esbuild web/main.tsx web/index.html --bundle --minify --loader:.html=copy --outdir=../internal/api/web",
    "test": "bun test && tsc --noEmit",
    "format": "prettier --write web *.json",
    "format:check": "prettier --check web *.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "preact": "^11.0.0",
    "radix-ui": "^1.6.7",
    "react": "npm:@preact/compat@^18.3.2",
    "react-dom": "npm:@preact/compat@^18.3.2",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "preact-render-to-string": "^6.8.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
