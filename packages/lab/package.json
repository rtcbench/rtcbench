{
  "name": "@rtcbench/lab",
  "version": "0.1.0",
  "description": "RTCBench tabs and resizable split panes for React",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lab/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtcbench/rtcbench.git",
    "directory": "packages/lab"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild index.ts --bundle --sourcemap --format=esm --packages=external --outfile=dist/index.js && tailwindcss -i styles.css -o dist/styles.css --minify && node ../package-assets.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
