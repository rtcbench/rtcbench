FROM oven/bun:1.4.2 AS bun
FROM golang:1.25-bookworm AS build
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /src/rtcbench
COPY --from=rtcbench /go.mod /go.sum /rtcbench.go /run.go /LICENSE ./
COPY --from=rtcbench /internal ./internal
COPY --from=rtcbench /pkg ./pkg
COPY --from=rtcbench /plugin ./plugin
COPY --from=rtcbench /docker ./docker
COPY --from=rtcbench /config-examples ./config-examples
COPY --from=rtcbench /packages ./packages
COPY --from=rtcbench /docs/media ./docs/media
WORKDIR /src/project
COPY . .
RUN make

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/project/rtcbench ./rtcbench
COPY --from=build /src/project/rtcbench-data /data
COPY benchmark.yml ./benchmark.yml
EXPOSE 8080
ENTRYPOINT ["./rtcbench"]
CMD ["-api-addr", "0.0.0.0:8080", "-data", "/data"]
